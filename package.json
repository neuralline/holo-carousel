{
  "name": "holo-carousel",
  "version": "3.0.0",
  "description": "Reactive carousel",
  "main": "dist/cjs/index.cjs",
  "module": "dist/es/index.js",
  "browser": "dist/umd/holo.js",
  "public": "public/js/holo.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "watch": "vite build --mode umd --watch",
    "serve": "vite --config vite.demo.config.ts",
    "start": "pnpm build && pnpm serve",
    "build": "vite build && vite build --mode umd",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --ext .ts,.tsx src",
    "prepublishOnly": "npm run test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "author": "Darik.",
  "license": "MIT",
  "homepage": "https://holo-carousel.firebaseapp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/neuralline/holo-carousel"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "5.1.1",
    "cyre": "link:../cyre",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "rimraf": "^6.1.4",
    "terser": "^5.51.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "HOLO",
    "light-weight",
    "vanilla",
    "javascript",
    "carousel",
    "slider",
    "CSS3 carousel",
    "swipe",
    "touch"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs",
      "browser": "./dist/umd/holo.js"
    }
  },
  "peerDependencies": {
    "cyre": "^5.0.0"
  },
  "types": "dist/types/index.d.ts"
}
